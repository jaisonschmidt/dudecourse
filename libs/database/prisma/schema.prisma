generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AuthProvider {
  CREDENTIALS
  GOOGLE
  GITHUB
}

model User {
  id          String   @id @default(uuid()) @db.Uuid
  email       String   @unique
  displayName String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  authAccounts AuthAccount[]
  enrollments  Enrollment[]

  @@map("users")
}

/// One row per sign-in method. CREDENTIALS rows carry passwordHash; OAuth rows leave it null.
model AuthAccount {
  id                String       @id @default(uuid()) @db.Uuid
  userId            String       @db.Uuid
  provider          AuthProvider
  providerAccountId String
  passwordHash      String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("auth_accounts")
}

model Course {
  id          String    @id @default(uuid()) @db.Uuid
  slug        String    @unique
  title       String
  description String
  /// Null means the course is not visible in the catalog.
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  /// Attribution fields for copyright compliance; all optional until backfilled.
  videoAuthor          String?
  youtubeChannel       String?
  /// Optional external link with more info about the author.
  authorInfoUrl        String?
  language             String?
  totalDurationMinutes Int?

  lessons     Lesson[]
  enrollments Enrollment[]

  @@map("courses")
}

model Lesson {
  id             String   @id @default(uuid()) @db.Uuid
  courseId       String   @db.Uuid
  title          String
  youtubeVideoId String
  position       Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  course   Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress LessonProgress[]

  @@unique([courseId, position])
  @@map("lessons")
}

model Enrollment {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  courseId   String   @db.Uuid
  enrolledAt DateTime @default(now())

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress    LessonProgress[]
  certificate Certificate?

  @@unique([userId, courseId])
  @@index([courseId])
  @@map("enrollments")
}

/// Source of truth for progress. Course completion percentage is derived, never stored.
model LessonProgress {
  id             String    @id @default(uuid()) @db.Uuid
  enrollmentId   String    @db.Uuid
  lessonId       String    @db.Uuid
  watchedPercent Int       @default(0)
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson     Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, lessonId])
  @@index([lessonId])
  @@map("lesson_progress")
}

model Certificate {
  id           String   @id @default(uuid()) @db.Uuid
  enrollmentId String   @unique @db.Uuid
  serialCode   String   @unique
  learnerName  String
  courseTitle  String
  issuedAt     DateTime @default(now())

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@map("certificates")
}
