{
  "name": "@dudecourse/source",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=20.11.0 <21",
    "npm": ">=10"
  },
  "scripts": {
    "build": "nx run-many -t build --all",
    "test": "nx run-many -t test --all",
    "lint": "nx run-many -t lint --all",
    "format": "nx format:write",
    "format:check": "nx format:check",
    "graph": "nx graph",
    "affected:build": "nx affected -t build",
    "affected:test": "nx affected -t test",
    "affected:lint": "nx affected -t lint",
    "dev": "nx run-many -t serve --projects=api,portal --parallel=2",
    "local:setup": "nx run database:migrate-deploy && nx run database:generate && nx run database:seed",
    "db:up": "docker compose up -d --wait database",
    "db:test:up": "docker compose up -d --wait database-test",
    "db:test:down": "docker compose stop database-test",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f database",
    "db:reset": "docker compose down --volumes && docker compose up -d --wait database && nx run database:migrate-deploy",
    "db:generate": "nx run database:generate",
    "db:validate": "nx run database:validate",
    "db:migrate": "nx run database:migrate-dev",
    "db:migrate:deploy": "nx run database:migrate-deploy",
    "db:migrate:status": "nx run database:migrate-status",
    "db:seed": "nx run database:seed",
    "db:studio": "nx run database:studio"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} libs/database/prisma/seed.ts"
  },
  "dependencies": {
    "@angular/common": "^17.3.12",
    "@angular/core": "17.3.12",
    "@angular/forms": "^17.3.12",
    "@angular/platform-browser": "^17.3.12",
    "@angular/router": "17.3.12",
    "@fastify/autoload": "~5.7.1",
    "@fastify/cookie": "^9.4.0",
    "@fastify/cors": "^8.5.0",
    "@fastify/jwt": "^8.0.1",
    "@fastify/oauth2": "7.9",
    "@fastify/sensible": "~5.2.0",
    "@prisma/client": "6.19.0",
    "axios": "^1.6.0",
    "fastify": "~4.13.0",
    "fastify-plugin": "~4.5.0",
    "pdf-lib": "^1.17.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~17.3.0",
    "@angular-devkit/core": "~17.3.0",
    "@angular-devkit/schematics": "~17.3.0",
    "@angular-eslint/eslint-plugin": "~17.3.0",
    "@angular-eslint/eslint-plugin-template": "~17.3.0",
    "@angular-eslint/template-parser": "~17.3.0",
    "@angular/cli": "~17.3.0",
    "@angular/compiler-cli": "17.3.12",
    "@angular/language-service": "~17.3.0",
    "@nx/angular": "19.8.14",
    "@nx/devkit": "19.8.14",
    "@nx/esbuild": "19.8.14",
    "@nx/eslint": "19.8.14",
    "@nx/eslint-plugin": "19.8.14",
    "@nx/jest": "19.8.14",
    "@nx/js": "19.8.14",
    "@nx/node": "19.8.14",
    "@nx/playwright": "19.8.14",
    "@nx/web": "19.8.14",
    "@nx/workspace": "19.8.14",
    "@playwright/test": "^1.36.0",
    "@schematics/angular": "~17.3.0",
    "@swc-node/register": "~1.9.1",
    "@swc/core": "~1.5.7",
    "@swc/helpers": "~0.5.11",
    "@types/jest": "^29.5.12",
    "@types/node": "18.16.9",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "autoprefixer": "^10.4.0",
    "esbuild": "^0.19.2",
    "eslint": "~8.57.0",
    "eslint-plugin-playwright": "^1.6.2",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "jest-preset-angular": "~14.1.0",
    "jsonc-eslint-parser": "^2.1.0",
    "ng-packagr": "~17.3.0",
    "nx": "19.8.14",
    "postcss": "^8.4.5",
    "postcss-url": "~10.1.3",
    "prettier": "^3.3.3",
    "prisma": "6.19.0",
    "ts-jest": "^29.1.0",
    "ts-node": "10.9.1",
    "typescript": "~5.4.5"
  },
  "overrides": {
    "@angular/animations": "17.3.12",
    "@angular/common": "17.3.12",
    "@angular/compiler": "17.3.12",
    "@angular/core": "17.3.12",
    "@angular/forms": "17.3.12",
    "@angular/platform-browser": "17.3.12",
    "@angular/platform-browser-dynamic": "17.3.12",
    "@angular/router": "17.3.12"
  }
}
