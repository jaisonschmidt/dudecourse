{
  "name": "@dudecourse/source",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=20.11.0 <21",
    "npm": ">=10"
  },
  "scripts": {
    "build": "nx run-many -t build --all",
    "test": "nx run-many -t test --all",
    "lint": "nx run-many -t lint --all",
    "format": "nx format:write",
    "format:check": "nx format:check",
    "graph": "nx graph",
    "affected:build": "nx affected -t build",
    "affected:test": "nx affected -t test",
    "affected:lint": "nx affected -t lint",
    "db:up": "docker compose up -d --wait database",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f database",
    "db:reset": "docker compose down --volumes && docker compose up -d --wait database && nx run database:migrate-deploy",
    "db:generate": "nx run database:generate",
    "db:validate": "nx run database:validate",
    "db:migrate": "nx run database:migrate-dev",
    "db:migrate:deploy": "nx run database:migrate-deploy",
    "db:migrate:status": "nx run database:migrate-status",
    "db:seed": "nx run database:seed",
    "db:studio": "nx run database:studio"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} libs/database/prisma/seed.ts"
  },
  "dependencies": {
    "@angular/core": "17.3.12",
    "@prisma/client": "6.19.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.3"
  },
  "devDependencies": {
    "@nx/angular": "19.8.14",
    "@nx/eslint": "19.8.14",
    "@nx/eslint-plugin": "19.8.14",
    "@nx/jest": "19.8.14",
    "@nx/js": "19.8.14",
    "@nx/node": "19.8.14",
    "@nx/playwright": "19.8.14",
    "@nx/workspace": "19.8.14",
    "@swc-node/register": "~1.9.1",
    "@swc/core": "~1.5.7",
    "@swc/helpers": "~0.5.11",
    "@types/jest": "^29.5.12",
    "@types/node": "18.16.9",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "eslint": "~8.57.0",
    "jest": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "nx": "19.8.14",
    "prettier": "^3.3.3",
    "prisma": "6.19.0",
    "ts-jest": "^29.1.0",
    "ts-node": "10.9.1",
    "typescript": "~5.4.5"
  },
  "overrides": {
    "@angular/animations": "17.3.12",
    "@angular/common": "17.3.12",
    "@angular/compiler": "17.3.12",
    "@angular/compiler-cli": "17.3.12",
    "@angular/core": "17.3.12",
    "@angular/forms": "17.3.12",
    "@angular/platform-browser": "17.3.12",
    "@angular/platform-browser-dynamic": "17.3.12",
    "@angular/router": "17.3.12"
  }
}
